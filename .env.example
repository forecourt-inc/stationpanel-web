# Demo-request email (https://resend.com). Without a key, submissions are
# written to ./data/demo-requests.jsonl and logged instead.
RESEND_API_KEY=
DEMO_TO_EMAIL=hello@stationpanel.com
# Must be an address on a domain verified in Resend.
DEMO_FROM_EMAIL="Station Panel <hello@stationpanel.com>"

# FAQ widget. With a key, /api/chat answers with Claude Haiku from content/faq.ts
# and site copy. Without one, it keyword-matches the FAQ.
ANTHROPIC_API_KEY=
